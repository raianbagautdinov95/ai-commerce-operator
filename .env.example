# Copy to .env and fill in. Never commit real secrets.

# --- Runtime safety ---
# Production deliberately refuses to start until real auth + tenant scoping are enabled.
APP_ENV=development

# --- Who is accountable for the data ---
# The privacy policy states these. Leave them blank and the page says plainly
# that nobody is named, and preflight refuses a production deployment: an
# unnamed controller means a data subject has nobody to exercise rights against.
# A plausible placeholder would be worse than a blank, so do not invent one.
LEGAL_ENTITY=
LEGAL_ADDRESS=
PRIVACY_CONTACT=
# Only if you are outside the EU/UK but serve people inside it.
LEGAL_EU_REPRESENTATIVE=
# The registration behind the trade name, where there is one. Shown on the
# privacy page so the controller can be looked up rather than taken on trust.
LEGAL_BUSINESS_ID=
LEGAL_BUSINESS_TYPE=
LEGAL_COUNTRY=
CORS_ALLOWED_ORIGINS=
AUTH_ENABLED=false
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=ai-commerce-operator
# How long a token from a login lasts, 1-30 days. Every token names a session
# that can be ended on its own — from the access screen, or with
# POST /api/auth/sessions/revoke-others — so this is a ceiling, not the only
# way out. Short still helps: it bounds a token nobody noticed was stolen.
SESSION_TOKEN_DAYS=7

# --- Signing in ---
# Two doors, both optional. With neither, the only way in is
# `python -m app.issue_token` and every new user needs an administrator.
#
# Google: create an OAuth 2.0 Client ID (type: Web application) at
# console.cloud.google.com. Scopes stay at openid/email/profile, which are
# non-sensitive and need no verification review — but publish the app to
# "In production", because in Testing mode it is capped at 100 users and
# authorizations expire after seven days. Add your domain under Authorized
# JavaScript origins (http://localhost:3002 for development) and fill in the
# consent screen's privacy policy and terms URLs; this app serves them at
# /privacy and /terms.
GOOGLE_CLIENT_ID=
# The frontend needs the same value at build time to render the button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is optional: the sign-in screen asks the API.

# Email codes: any Resend API key, and a sender on a domain you verified there.
# Without both, requesting a code answers 503 in staging and production. In
# development the code is written to the server log instead, which is why that
# fallback is refused anywhere else.
RESEND_API_KEY=
LOGIN_EMAIL_FROM=
# Where `preflight --send-test-email` posts its one real message. A key
# being set is not a working mailer — the domain can be unverified and
# nothing says so until a merchant cannot sign in. Only that flag sends;
# a plain run and --live never do.
PREFLIGHT_EMAIL=

# --- Encrypted integration credentials ---
# JSON keyring; each value is a base64-encoded random 32-byte AES key.
# Keep old versions during rotation until all stored credentials are re-encrypted.
CREDENTIAL_ENCRYPTION_KEYS={}
CREDENTIAL_ACTIVE_KEY_VERSION=v1

# --- Durable background jobs ---
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- Commercial access ---
# Public feedback cohort: the first completed Shopify connections receive this
# card-free period. A disconnected participant still holds their place.
TRIAL_DAYS=15
PILOT_MAX_SHOPIFY_STORES=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_SCALE=
# What the Operator charges per month, used by the payroll to prove it earns its
# keep. Defaults: starter 19, operator 49, scale 149.
PLAN_PRICE_STARTER=
PLAN_PRICE_OPERATOR=
PLAN_PRICE_SCALE=
STRIPE_SUCCESS_URL=https://your-app.example/setup?checkout=success
STRIPE_CANCEL_URL=https://your-app.example/setup?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://your-app.example/setup

# --- Database ---
DATABASE_URL=postgresql+psycopg://aco:aco@localhost:5432/aco
POSTGRES_PASSWORD=
# The application connects as aco_app, which migration 0016 creates as
# NOSUPERUSER NOBYPASSRLS — row-level security never constrains a superuser, so
# an app running as the owner has policies that protect nothing.
# Letters and digits only: 0016 interpolates this into a CREATE ROLE statement.
APP_DB_ROLE=aco_app
APP_DB_PASSWORD=
# Only where migrations run inside the application's own environment, such as a
# platform pre-deploy step: alembic uses this instead of DATABASE_URL, so the
# migration gets the owner while the server keeps the restricted role. Leave it
# unset under Docker Compose, where the migrate service already has its own URL.
MIGRATION_DATABASE_URL=
PUBLIC_API_BASE=http://localhost:8000
BACKUP_RETENTION_DAYS=14

# --- Error tracking (optional locally, recommended for staging/production) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_RELEASE=

# --- LLM explanation layer (optional) ---
# LLM_PROVIDER: none | openai | anthropic   (primary; none = deterministic template)
# LLM_LANG: en | ru                          (language of the generated explanation)
# If both API keys are set, the layer auto-falls-back to the other provider when
# the primary errors (rate limit / network / bad key), then to the template.
LLM_PROVIDER=none
LLM_MODEL=
LLM_LANG=en
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Creative agent concept images (uses OPENAI_API_KEY):
LLM_IMAGE_MODEL=gpt-image-1
LLM_IMAGE_COUNT=2

# --- Amazon integrations (Phase 1) ---
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_APPLICATION_ID=
SP_API_REDIRECT_URI=http://localhost:8000/api/integrations/amazon/callback
SP_API_AUTHORIZATION_URL=https://sellercentral-europe.amazon.com/apps/authorize/consent
SP_API_APP_VERSION=beta
SP_API_USER_AGENT=AICommerceOperator/0.1
# Amazon Advertising API. Needs its own approved application in Developer
# Central plus a Professional seller account; the LWA scope is
# advertising::campaign_management. Region follows the marketplace: NA | EU | FE.
ADS_API_CLIENT_ID=
ADS_API_CLIENT_SECRET=
ADS_API_REGION=EU
# Writing to the ad account is opt-in and separate from reading it. With this
# off (the default) the Operator reads, proposes and stages; nothing in the
# account changes. Turn it on only after watching what it proposes.
ADS_WRITE_ENABLED=false

# --- Shopify integration ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://your-app.example/api/integrations/shopify/callback
SHOPIFY_WEBHOOK_URI=https://your-app.example/api/webhooks/shopify
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES=read_products,read_orders,read_inventory

# --- WooCommerce integration ---
# WooCommerce posts generated read-only credentials to the HTTPS callback.
WOOCOMMERCE_CALLBACK_URI=https://your-app.example/api/integrations/woocommerce/callback
WOOCOMMERCE_RETURN_URI=https://your-app.example/integrations/woocommerce

# --- Product discovery ---
# DISCOVERY_SOURCE: sample (default) | keepa
DISCOVERY_SOURCE=sample
KEEPA_API_KEY=
# Realism guards: skip products too pricey to private-label, and project a conservative
# capturable monthly volume (a new seller won't get the market leader's full sales).
DISCOVERY_MAX_PRICE=75
DISCOVERY_SALES_CAP=1500
DISCOVERY_PPC_RATIO=0.12     # estimated ad spend per unit as a share of price

# --- Supplier finder ---
# SUPPLIER_SOURCE: sample (default) | rapidapi
SUPPLIER_SOURCE=sample
# For rapidapi: subscribe to an Alibaba/1688 product API on rapidapi.com, then set:
RAPIDAPI_KEY=
RAPIDAPI_HOST=                 # e.g. 1688-product2.p.rapidapi.com
RAPIDAPI_SEARCH_PATH=/search   # the search endpoint path for that API
RAPIDAPI_QUERY_PARAM=keyword   # the query parameter name that API expects

# --- Autopilot (autonomous loop; OFF by default) ---
# When true, the agents scan AUTOPILOT_NICHES every AUTOPILOT_INTERVAL_HOURS into the
# approval queue. Each niche scan spends discovery API tokens — enable deliberately.
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_HOURS=24
AUTOPILOT_NICHES=

# --- Support, shown to customers on any onboarding error ---------------------
# Not hard-coded anywhere: an address in the source cannot be changed without a
# deploy, and is usually somebody's personal mail. The pilot gate blocks a paid
# launch without both of these.
# Where a customer lands from a link in an email. It outlives the deploy that
# sent it by weeks, so this must be a stable https address — never a tunnel,
# never localhost. Used by the billing and trial emails and by the scheduler.
PUBLIC_APP_URL=
SUPPORT_EMAIL=
SUPPORT_RESPONSE_TIME=
SUPPORT_URL=

# --- Separate offsite backup service only (never expose to the frontend) ---
# Supply PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE from Railway postgres.
# Use a private external S3-compatible bucket with encryption and a 14-day lock.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=aco/production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
